{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mockly interview prompt evaluation case",
  "type": "object",
  "required": ["caseId", "target", "source", "input", "tags", "mustSatisfy", "forbiddenErrors"],
  "properties": {
    "caseId": {"type": "string", "minLength": 1},
    "target": {"enum": ["FIRST_QUESTION", "FOLLOW_UP_QUESTION", "FEEDBACK"]},
    "source": {"enum": ["ANONYMIZED", "SYNTHETIC"]},
    "input": {"type": "object"},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "mustSatisfy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "forbiddenErrors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
